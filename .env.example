# Auth
AUTH_SECRET=your-auth-secret-here

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Feedback (optional; falls back to RESEND_FROM_EMAIL)
FEEDBACK_EMAIL=

# Test accounts (comma-separated emails that bypass email verification)
TEST_ACCOUNT_EMAILS=

# Rate limiting (Upstash Redis — optional but strongly recommended for production)
# Get these from https://console.upstash.com after creating a Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inbound email forwarding (Resend webhook)
# RESEND_WEBHOOK_SECRET: signing secret from Resend → Webhooks → your webhook
# INBOUND_FORWARD_TO: your personal email where inbound mail gets forwarded
RESEND_WEBHOOK_SECRET=
INBOUND_FORWARD_TO=
