    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^11.15.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.544.0",
    "mongodb": "^6.21.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "resend": "^6.9.2",
