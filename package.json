{
  "name": "pretvia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:skip-email": "SKIP_EMAIL=1 next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\" --ignore-path .gitignore",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "cypress open",
    "e2e:ci": "pnpm seed:test && start-server-and-test dev:skip-email http://localhost:3000 cy:run",
    "e2e:ci:record": "pnpm seed:test && start-server-and-test dev:skip-email http://localhost:3000 'cypress run --record'",
    "e2e:ci:spec": "node scripts/e2e-ci-spec.mjs",
    "e2e:ci:spec:record": "node scripts/e2e-ci-spec.mjs --record",
    "seed:test": "tsx scripts/seed-test-users.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
